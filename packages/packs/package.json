{
  "name": "@tjalve/memex-packs",
  "version": "0.1.0",
  "description": "Memex packs: a typed client for the packs of Memex.Node, read-only resolution of the pack store, and a layout writer under the store lock for an app's own downloader",
  "license": "MIT",
  "author": "Tjalve Aarflot",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZarK/memex.core.git",
    "directory": "packages/packs"
  },
  "homepage": "https://github.com/ZarK/memex.core/tree/main/packages/packs#readme",
  "bugs": {
    "url": "https://github.com/ZarK/memex.core/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && vitest run"
  },
  "dependencies": {
    "@tjalve/memex-node-client": "workspace:*",
    "@tjalve/memex-storage": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "typescript": "5.9.2",
    "vitest": "4.1.11"
  },
  "publishConfig": {
    "access": "public"
  }
}
