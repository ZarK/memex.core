{
  "name": "@tjalve/memex-import",
  "version": "0.2.0",
  "description": "Memex import: walk folders and archives, detect the reader, normalize, hash, dedupe on provenance, preview as a rolled-back transaction, commit per file, and undo a batch",
  "license": "MIT",
  "author": "Tjalve Aarflot",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZarK/memex.core.git",
    "directory": "packages/import"
  },
  "homepage": "https://github.com/ZarK/memex.core/tree/main/packages/import#readme",
  "bugs": {
    "url": "https://github.com/ZarK/memex.core/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "memex-import": "dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@tjalve/memex-archive": "workspace:*",
    "@tjalve/memex-folders": "workspace:*",
    "@tjalve/memex-schema": "workspace:*",
    "@tjalve/memex-sqlite": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "5.9.2",
    "vitest": "4.1.11"
  },
  "publishConfig": {
    "access": "public"
  }
}
