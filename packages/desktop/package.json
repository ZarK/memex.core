{
  "name": "@tjalve/memex-desktop",
  "version": "0.1.0",
  "description": "The Memex desktop shell: one Electron main process for every Memex app, with its local server, the ready line, the token cookie, the sandbox, the crash screen, About from notices.json, the CLI shim, the electron-builder base config and the release scripts",
  "license": "MIT",
  "author": "Tjalve Aarflot",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZarK/memex.core.git",
    "directory": "packages/desktop"
  },
  "homepage": "https://github.com/ZarK/memex.core/tree/main/packages/desktop#readme",
  "bugs": {
    "url": "https://github.com/ZarK/memex.core/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./build": {
      "types": "./dist/build.d.ts",
      "import": "./dist/build.js"
    }
  },
  "bin": {
    "memex-desktop": "dist/bin.js"
  },
  "files": [
    "dist",
    "assets"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@tjalve/memex-node-client": "workspace:*",
    "@tjalve/memex-storage": "workspace:*"
  },
  "peerDependencies": {
    "electron": ">=44.7.0"
  },
  "peerDependenciesMeta": {
    "electron": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "electron": "44.7.0",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "publishConfig": {
    "access": "public"
  }
}
