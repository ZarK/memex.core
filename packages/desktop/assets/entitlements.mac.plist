<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The hardened runtime entitlements of a Memex app signed with a Developer ID: only the JIT that V8 needs.
     No com.apple.security.cs.allow-dyld-environment-variables, so DYLD_INSERT_LIBRARIES and the like are ignored. -->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
</dict>
</plist>
