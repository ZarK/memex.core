{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ZarK/memex.core/schemas/user/common.json",
  "title": "Memex.User shared definitions",
  "description": "Values that more than one record kind uses. See contracts/user-records.md.",
  "$defs": {
    "kind": {
      "enum": ["person", "home", "workplace", "place", "stay", "trip", "chapter", "milestone"]
    },
    "recordId": {
      "type": "string",
      "pattern": "^(person|home|workplace|place|stay|trip|chapter|milestone)_[0-9a-f]{32}$"
    },
    "personId": {
      "type": "string",
      "pattern": "^person_[0-9a-f]{32}$",
      "description": "The id of the owner's person record."
    },
    "homeId": { "type": "string", "pattern": "^home_[0-9a-f]{32}$" },
    "tripId": { "type": "string", "pattern": "^trip_[0-9a-f]{32}$" },
    "placeLikeId": { "type": "string", "pattern": "^(home|workplace|place)_[0-9a-f]{32}$" },
    "correctionId": { "type": "string", "pattern": "^cor_[0-9a-f]{32}$" },
    "changeId": { "type": "string", "pattern": "^chg_[0-9a-f]{32}$" },
    "appId": { "type": "string", "pattern": "^[a-z][a-z0-9]*$" },
    "scope": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*\\.(persons|homes|workplaces|places|stays|trips|chapters|milestones)$",
      "description": "<app>.<kinds>, for example photos.trips."
    },
    "partition": { "type": "string", "minLength": 1, "maxLength": 64 },
    "claimKey": { "type": "string", "minLength": 1, "maxLength": 200 },
    "ref": {
      "type": "object",
      "required": ["app", "kind", "id"],
      "properties": {
        "app": { "$ref": "common.json#/$defs/appId" },
        "kind": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "id": { "type": "string", "minLength": 1, "maxLength": 200 }
      },
      "additionalProperties": false,
      "description": "A record in an app."
    },
    "contactRef": {
      "type": "object",
      "required": ["app", "kind", "id"],
      "properties": {
        "app": { "const": "contacts" },
        "kind": { "const": "person" },
        "id": { "type": "string", "minLength": 1, "maxLength": 200 }
      },
      "additionalProperties": false
    },
    "personRef": {
      "description": "The owner's User person id, or a Contacts person. User follows Contacts redirects (mergedInto) when it reads a reference.",
      "oneOf": [
        { "$ref": "common.json#/$defs/personId" },
        { "$ref": "common.json#/$defs/contactRef" }
      ]
    },
    "location": {
      "type": "object",
      "required": ["lat", "lon"],
      "properties": {
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lon": { "type": "number", "minimum": -180, "maximum": 180 },
        "radiusM": { "type": "number", "exclusiveMinimum": 0 }
      },
      "additionalProperties": false
    },
    "country": { "type": "string", "pattern": "^[A-Z]{2}$", "description": "ISO 3166-1 alpha-2." },
    "localDate": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
    },
    "partialDate": {
      "type": "string",
      "pattern": "^[0-9]{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12][0-9]|3[01]))?)?$",
      "description": "YYYY, YYYY-MM, or YYYY-MM-DD."
    },
    "utcTime": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "text": { "type": "string", "minLength": 1, "maxLength": 500 },
    "kindFields": {
      "description": "The fields object of an instance, checked against the schema of its kind.",
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "person" } }, "required": ["kind"] },
          "then": { "properties": { "fields": { "$ref": "person.json" } } }
        },
        {
          "if": { "properties": { "kind": { "const": "home" } }, "required": ["kind"] },
          "then": { "properties": { "fields": { "$ref": "home.json" } } }
        },
        {
          "if": { "properties": { "kind": { "const": "workplace" } }, "required": ["kind"] },
          "then": { "properties": { "fields": { "$ref": "workplace.json" } } }
        },
        {
          "if": { "properties": { "kind": { "const": "place" } }, "required": ["kind"] },
          "then": { "properties": { "fields": { "$ref": "place.json" } } }
        },
        {
          "if": { "properties": { "kind": { "const": "stay" } }, "required": ["kind"] },
          "then": { "properties": { "fields": { "$ref": "stay.json" } } }
        },
        {
          "if": { "properties": { "kind": { "const": "trip" } }, "required": ["kind"] },
          "then": { "properties": { "fields": { "$ref": "trip.json" } } }
        },
        {
          "if": { "properties": { "kind": { "const": "chapter" } }, "required": ["kind"] },
          "then": { "properties": { "fields": { "$ref": "chapter.json" } } }
        },
        {
          "if": { "properties": { "kind": { "const": "milestone" } }, "required": ["kind"] },
          "then": { "properties": { "fields": { "$ref": "milestone.json" } } }
        }
      ]
    }
  }
}
