{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ZarK/memex.core/schemas/surfaces/error.json",
  "title": "Error body",
  "description": "The one error body of every Memex HTTP API, MCP tool error, and CLI --json failure. See contracts/surfaces.md.",
  "type": "object",
  "required": ["error"],
  "properties": {
    "error": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "message": { "type": "string", "minLength": 1 },
        "field": { "type": "string" },
        "hint": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
