{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ZarK/memex.core/schemas/contacts/correction.json",
  "title": "Correction",
  "description": "A decision of the person about a Contacts record. Inference never changes it. The app makes id and createdAt when the person acts. See contracts/contacts-records.md and contracts/facts.md.",
  "type": "object",
  "required": ["id", "op", "app", "createdAt"],
  "properties": {
    "id": { "$ref": "../user/common.json#/$defs/correctionId" },
    "op": {
      "enum": ["set", "clear", "reject", "restore", "merge", "create", "unmerge", "pin", "unpin"]
    },
    "app": {
      "$ref": "../user/common.json#/$defs/appId",
      "description": "The app in which the person acted."
    },
    "createdAt": {
      "$ref": "../user/common.json#/$defs/utcTime",
      "description": "The time at which the person acted, not the time of the send."
    },
    "record": {
      "$ref": "common.json#/$defs/recordId",
      "description": "The record that the correction changes. unmerge: the merged person. create: the new record, in the stored form."
    },
    "records": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "common.json#/$defs/recordId" },
      "uniqueItems": true,
      "description": "merge: records of one kind; the first id stays, and merged persons keep a redirect. pin and unpin: exactly two persons."
    },
    "kind": { "$ref": "common.json#/$defs/kind" },
    "person": {
      "$ref": "common.json#/$defs/personId",
      "description": "create of a kind other than person: the person that the new record is about."
    },
    "other": {
      "$ref": "common.json#/$defs/personId",
      "description": "create of a relation (required) or a date: the other person."
    },
    "fields": {
      "type": "object",
      "minProperties": 1,
      "description": "set: the fields to set; a list field can instead take {add, remove}. create: all fields of the kind."
    },
    "names": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "$ref": "../user/common.json#/$defs/ref" },
      "description": "create only: the app's own records that the new record comes from."
    },
    "anchors": {
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "../facts/facts.json#/$defs/claimRef" },
      "description": "Set by Contacts when it stores the correction: the claim keys of its record then. An app does not send it."
    }
  },
  "allOf": [
    {
      "if": { "properties": { "op": { "const": "set" } } },
      "then": { "required": ["record", "fields"] }
    },
    {
      "if": { "properties": { "op": { "const": "clear" } } },
      "then": { "required": ["record", "names"] }
    },
    {
      "if": { "properties": { "op": { "enum": ["reject", "restore", "unmerge"] } } },
      "then": { "required": ["record"] }
    },
    { "if": { "properties": { "op": { "const": "merge" } } }, "then": { "required": ["records"] } },
    {
      "if": { "properties": { "op": { "enum": ["pin", "unpin"] } } },
      "then": {
        "required": ["records"],
        "properties": {
          "records": { "maxItems": 2, "items": { "$ref": "common.json#/$defs/personId" } }
        }
      }
    },
    {
      "if": { "properties": { "op": { "const": "unmerge" } } },
      "then": { "properties": { "record": { "$ref": "common.json#/$defs/personId" } } }
    },
    {
      "if": { "properties": { "op": { "not": { "const": "create" } } } },
      "then": {
        "not": {
          "anyOf": [
            { "required": ["sources"] },
            { "required": ["person"] },
            { "required": ["other"] }
          ]
        }
      }
    },
    {
      "if": { "properties": { "op": { "const": "create" } } },
      "then": {
        "required": ["kind", "fields"],
        "allOf": [
          { "$ref": "common.json#/$defs/kindFields" },
          {
            "if": { "properties": { "kind": { "const": "person" } } },
            "then": { "not": { "anyOf": [{ "required": ["person"] }, { "required": ["other"] }] } },
            "else": { "required": ["person"] }
          },
          {
            "if": { "properties": { "kind": { "const": "relation" } } },
            "then": { "required": ["other"] }
          },
          {
            "if": {
              "properties": { "kind": { "enum": ["home", "workplace", "circle", "identity"] } }
            },
            "then": { "not": { "required": ["other"] } }
          }
        ]
      }
    }
  ],
  "additionalProperties": false
}
