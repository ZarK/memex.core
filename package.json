{
  "name": "memex-core",
  "version": "0.1.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.13.1",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm run test:release && pnpm -r test",
    "test:release": "node --test \"test/release/*.test.mjs\"",
    "release": "node scripts/release-set.mjs",
    "release:prepare": "node scripts/prepare-release.mjs",
    "release:approve": "node scripts/approve-staged-release.mjs",
    "release:check": "node scripts/check-release-manifests.mjs"
  }
}
