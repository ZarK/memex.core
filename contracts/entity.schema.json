{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ZarK/memex.core/contracts/entity.schema.json",
  "title": "Entity",
  "description": "A row in the entity spine. Domain fields live in module-owned tables keyed by this id.",
  "type": "object",
  "required": ["id", "type", "created_at", "updated_at"],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9_]*)+$",
      "description": "Namespaced entity type, e.g. 'finance.account'."
    },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "deleted_at": { "type": ["string", "null"], "format": "date-time" }
  },
  "additionalProperties": false
}
