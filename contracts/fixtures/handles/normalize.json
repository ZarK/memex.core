{
  "format": "memex.handles.fixtures/1",
  "description": "normalizeHandle(raw, options) cases. Each case has the raw text, the options, and either the expected handle or the expected error code. All numbers and addresses are made up. The Norwegian numbers (+47 400 00 0xx) only show how a default region works; the other numbers are in the US range 555-0100 to 555-0199, which is kept for fiction.",
  "cases": [
    { "name": "international phone", "raw": "+47 400 00 000", "options": { "region": "NO" }, "expected": { "kind": "phone", "raw": "+47 400 00 000", "status": "normalized", "value": "+4740000000" } },
    { "name": "national phone with the default region", "raw": "400 00 000", "options": { "region": "NO" }, "expected": { "kind": "phone", "raw": "400 00 000", "status": "normalized", "value": "+4740000000" } },
    { "name": "region is not case sensitive", "raw": "400 00 003", "options": { "region": "no" }, "expected": { "kind": "phone", "raw": "400 00 003", "status": "normalized", "value": "+4740000003" } },
    { "name": "00 prefix with the default region", "raw": "0047 400 00 000", "options": { "region": "NO" }, "expected": { "kind": "phone", "raw": "0047 400 00 000", "status": "normalized", "value": "+4740000000" } },
    { "name": "00 prefix without a region", "raw": "0047 400 00 000", "options": {}, "expected": { "kind": "phone", "raw": "0047 400 00 000", "status": "unparsed" } },
    { "name": "national phone without a region", "raw": "400 00 000", "options": {}, "expected": { "kind": "phone", "raw": "400 00 000", "status": "unparsed" } },
    { "name": "foreign number keeps its own country", "raw": "+1 201-555-0123", "options": { "region": "NO" }, "expected": { "kind": "phone", "raw": "+1 201-555-0123", "status": "normalized", "value": "+12015550123" } },
    { "name": "US national number", "raw": "(201) 555-0123", "options": { "region": "US" }, "expected": { "kind": "phone", "raw": "(201) 555-0123", "status": "normalized", "value": "+12015550123" } },
    { "name": "tel URI", "raw": "tel:+12015550101", "options": {}, "expected": { "kind": "phone", "raw": "tel:+12015550101", "status": "normalized", "value": "+12015550101" } },
    { "name": "raw text is kept as written", "raw": "  +1 201-555-0101 ", "options": {}, "expected": { "kind": "phone", "raw": "  +1 201-555-0101 ", "status": "normalized", "value": "+12015550101" } },
    { "name": "short code", "raw": "2222", "options": { "region": "NO" }, "expected": { "kind": "phone", "raw": "2222", "status": "unparsed" } },
    { "name": "alphanumeric sender on SMS", "raw": "PAKKE", "options": { "region": "NO", "service": "sms" }, "expected": { "kind": "phone", "raw": "PAKKE", "status": "unparsed" } },
    { "name": "number with an extension", "raw": "+1 201-555-0100 ext 12", "options": { "region": "NO" }, "expected": { "kind": "phone", "raw": "+1 201-555-0100 ext 12", "status": "unparsed" } },
    { "name": "extension after #", "raw": "+1 201-555-0100#12", "options": { "region": "NO" }, "expected": { "kind": "phone", "raw": "+1 201-555-0100#12", "status": "unparsed" } },
    { "name": "extension after a comma", "raw": "+12015550100,12", "options": { "region": "NO" }, "expected": { "kind": "phone", "raw": "+12015550100,12", "status": "unparsed" } },
    { "name": "extension after a semicolon", "raw": "+1 201-555-0100;12", "options": { "region": "NO" }, "expected": { "kind": "phone", "raw": "+1 201-555-0100;12", "status": "unparsed" } },
    { "name": "extension after DTMF pauses", "raw": "+1 201-555-0123,,456", "options": { "region": "US" }, "expected": { "kind": "phone", "raw": "+1 201-555-0123,,456", "status": "unparsed" } },
    { "name": "hidden caller", "raw": "", "options": { "region": "NO", "service": "phone" }, "expected": { "kind": "phone", "raw": "", "status": "unparsed" } },
    { "name": "email is lowercased", "raw": "Ada.Lovelace@Example.COM", "options": {}, "expected": { "kind": "email", "raw": "Ada.Lovelace@Example.COM", "status": "normalized", "value": "ada.lovelace@example.com" } },
    { "name": "email keeps dots and plus tags", "raw": "ada.l+cabin@example.com", "options": {}, "expected": { "kind": "email", "raw": "ada.l+cabin@example.com", "status": "normalized", "value": "ada.l+cabin@example.com" } },
    { "name": "email with a display name", "raw": "Bjorn Example <Bjorn@Example.org>", "options": { "service": "mail" }, "expected": { "kind": "email", "raw": "Bjorn Example <Bjorn@Example.org>", "status": "normalized", "value": "bjorn@example.org" } },
    { "name": "mailto URI", "raw": "mailto:Carl@Example.net", "options": {}, "expected": { "kind": "email", "raw": "mailto:Carl@Example.net", "status": "normalized", "value": "carl@example.net" } },
    { "name": "iMessage email handle", "raw": "carl@example.net", "options": { "region": "NO", "service": "imessage" }, "expected": { "kind": "email", "raw": "carl@example.net", "status": "normalized", "value": "carl@example.net" } },
    { "name": "mail address that does not parse", "raw": "undisclosed-recipients:;", "options": { "service": "mail" }, "expected": { "kind": "email", "raw": "undisclosed-recipients:;", "status": "unparsed" } },
    { "name": "WhatsApp JID with a phone number", "raw": "12015550102@s.whatsapp.net", "options": { "region": "NO", "service": "whatsapp" }, "expected": { "kind": "platform", "raw": "12015550102@s.whatsapp.net", "status": "raw", "value": "12015550102@s.whatsapp.net", "phone": "+12015550102" } },
    { "name": "WhatsApp group JID", "raw": "120363000000000001@g.us", "options": { "service": "whatsapp" }, "expected": { "kind": "platform", "raw": "120363000000000001@g.us", "status": "raw", "value": "120363000000000001@g.us" } },
    { "name": "WhatsApp phone number without a JID", "raw": "+1 201-555-0102", "options": { "region": "NO", "service": "whatsapp" }, "expected": { "kind": "phone", "raw": "+1 201-555-0102", "status": "normalized", "value": "+12015550102" } },
    { "name": "MSN account keeps its platform form", "raw": "Bjorn@Example.net", "options": { "service": "msn" }, "expected": { "kind": "platform", "raw": "Bjorn@Example.net", "status": "raw", "value": "Bjorn@Example.net" } },
    { "name": "Telegram user name", "raw": " @ada_example ", "options": { "service": "telegram" }, "expected": { "kind": "platform", "raw": " @ada_example ", "status": "raw", "value": "@ada_example" } },
    { "name": "empty platform handle", "raw": " ", "options": { "service": "telegram" }, "expected": { "kind": "platform", "raw": " ", "status": "unparsed" } },
    { "name": "kind from the source wins", "raw": "40000000", "options": { "kind": "platform" }, "expected": { "kind": "platform", "raw": "40000000", "status": "raw", "value": "40000000" } },
    { "name": "unknown region", "raw": "400 00 000", "options": { "region": "XX" }, "error": "unknown-region" }
  ]
}
