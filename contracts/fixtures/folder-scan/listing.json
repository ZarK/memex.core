    {
      "name": "names that collide by case or after normalization: the first in ordinal order is listed",
      "tree": {
        "fileSystem": "ntfs",
        "ignoresCase": true,
        "folders": {
          "": [
            {
              "name": "a.jpg",
              "size": 1
            },
            {
              "name": "A.jpg",
              "size": 2
            },
            {
              "name": "café.jpg",
              "size": 3
            },
            {
              "name": "café.jpg",
              "size": 4
            },
            {
              "name": "Ålesund",
              "type": "folder"
            },
            {
              "name": "Ålesund",
              "type": "folder"
            }
          ],
          "Ålesund": [
            {
              "name": "x.jpg",
              "size": 5
            }
          ],
          "Ålesund": [
            {
              "name": "y.jpg",
              "size": 6
            }
          ]
        }
      },
      "expected": {
        "files": [
          [
            "A.jpg",
            false,
            true
          ],
          [
            "café.jpg",
            false,
            true
          ],
          [
            "Ålesund/x.jpg",
            false,
            true
          ]
        ],
        "listedFolders": [
          "",
          "Ålesund"
        ],
        "skippedFolders": [
          "Ålesund"
        ],
        "skippedFiles": [
          "a.jpg",
          "café.jpg"
        ],
        "links": [],
        "warnings": [
          [
            "names-collide-by-case",
            "a.jpg"
          ],
          [
            "names-collide-after-normalization",
            "café.jpg"
          ],
          [
            "names-collide-after-normalization",
            "Ålesund"
          ]
        ],
        "complete": true
      }
    },
