{
  "description": "listFolder() over a fixture tree. Root /fixture (POSIX paths) unless the case sets platform win32. tree.folderIds gives a folder's id by path (default folder:<path>); two folders with one id are one folder seen twice. An entry has name and optional type (file, folder, link, other; default file), size, modifiedMs, createdMs, attributes, reparseTag, flags, fileId, invalidName. expected.files lists [path, onlineOnly, sizeKnown] in walk order.",
  "cases": [
    {
      "name": "hidden and system names are left out",
      "tree": {
        "folders": {
          "": [
            {
              "name": "a.jpg",
              "size": 10
            },
            {
              "name": ".hidden.jpg",
              "size": 10
            },
            {
              "name": "Thumbs.db",
              "size": 10,
              "attributes": 6
            },
            {
              "name": ".git",
              "type": "folder"
            },
            {
              "name": "$RECYCLE.BIN",
              "type": "folder"
            },
            {
              "name": "System Volume Information",
              "type": "folder"
            },
            {
              "name": ".Trash-1000",
              "type": "folder"
            },
            {
              "name": "photos",
              "type": "folder"
            }
          ],
          "photos": [
            {
              "name": "b.jpg",
              "size": 20
            }
          ]
        }
      },
      "expected": {
        "files": [
          [
            "a.jpg",
            false,
            true
          ],
          [
            "photos/b.jpg",
            false,
            true
          ]
        ],
        "listedFolders": [
          "",
          "photos"
        ],
        "skippedFolders": [
          "$RECYCLE.BIN",
          ".Trash-1000",
          ".git",
          "System Volume Information"
        ],
        "skippedFiles": [
          ".hidden.jpg",
          "Thumbs.db"
        ],
        "links": [],
        "warnings": [],
        "complete": true
      }
    },
    {
      "name": "includeHidden lists hidden names but never system folders",
      "options": {
        "includeHidden": true
      },
      "tree": {
        "folders": {
          "": [
            {
              "name": ".hidden.jpg",
              "size": 10
            },
            {
              "name": ".git",
              "type": "folder"
            },
            {
              "name": "$RECYCLE.BIN",
              "type": "folder"
            }
          ],
          ".git": [
            {
              "name": "HEAD",
              "size": 1
            }
          ]
        }
      },
      "expected": {
        "files": [
          [
            ".hidden.jpg",
            false,
            true
          ],
          [
            ".git/HEAD",
            false,
            true
          ]
        ],
        "listedFolders": [
          "",
          ".git"
        ],
        "skippedFolders": [
          "$RECYCLE.BIN"
        ],
        "skippedFiles": [],
        "links": [],
        "warnings": [],
        "complete": true
      }
    },
    {
      "name": "links are never followed",
      "tree": {
        "folders": {
          "": [
            {
              "name": "a.jpg",
              "size": 1
            },
            {
              "name": "to-folder",
              "type": "link"
            },
            {
              "name": "to-file.jpg",
              "type": "link"
            }
          ]
        }
      },
      "expected": {
        "files": [
          [
            "a.jpg",
            false,
            true
          ]
        ],
        "listedFolders": [
          ""
        ],
        "skippedFolders": [],
        "skippedFiles": [],
        "links": [
          "to-file.jpg",
          "to-folder"
        ],
        "warnings": [],
        "complete": true
      }
    },
    {
      "name": "Windows: recall and offline attributes are online-only; a downloaded cloud file is local",
      "tree": {
        "platform": "win32",
        "fileSystem": "ntfs",
        "ignoresCase": true,
        "folders": {
          "": [
            {
              "name": "online.jpg",
              "size": 100,
              "attributes": 4200992,
              "reparseTag": 2415943706
            },
            {
              "name": "downloaded.jpg",
              "size": 100,
              "attributes": 1056,
              "reparseTag": 2415943706
            },
            {
              "name": "recall-on-open.jpg",
              "size": 100,
              "attributes": 262176
            },
            {
              "name": "offline.jpg",
              "size": 100,
              "attributes": 4128
            },
            {
              "name": "pinned.jpg",
              "size": 100,
              "attributes": 525344,
              "reparseTag": 2415943706
            }
          ]
        }
      },
      "expected": {
        "files": [
          [
            "downloaded.jpg",
            false,
            true
          ],
          [
            "offline.jpg",
            true,
            true
          ],
          [
            "online.jpg",
            true,
            true
          ],
          [
            "pinned.jpg",
            false,
            true
          ],
          [
            "recall-on-open.jpg",
            true,
            true
          ]
        ],
        "listedFolders": [
          ""
        ],
        "skippedFolders": [],
        "skippedFiles": [],
        "links": [],
        "warnings": [],
        "complete": true
      }
    },
